# {{ ansible_managed }}
# Connectivity-testing only (doc §4.3c) — browsers silently drop untrusted
# subresources like map tiles, with no click-through warning. Set
# eck_map_cert_manager_create_selfsigned_issuer: false and point
# eck_map_cert_issuer_name/kind at a real internal CA before production use.
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: {{ eck_map_selfsigned_issuer_name }}
  namespace: {{ eck_map_namespace }}
  labels:
{{ (eck_map_labels | to_nice_yaml(indent=2) | indent(4, first=True)).rstrip('\n') }}
spec:
  selfSigned: {}
