# {{ ansible_managed }}
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ eck_map_certificate_name }}
  namespace: {{ eck_map_namespace }}
  labels:
{{ (eck_map_labels | to_nice_yaml(indent=2) | indent(4, first=True)).rstrip('\n') }}
spec:
  secretName: {{ eck_map_certificate_secret_name }}
  issuerRef:
    name: {{ eck_map_cert_issuer_name }}
    kind: {{ eck_map_cert_issuer_kind }}
  ipAddresses:
    # Must be an IP address, not a dnsName: clients connect via this
    # MetalLB VIP, not a hostname (doc §4.3c).
    - "{{ eck_map_tile_vip }}"
